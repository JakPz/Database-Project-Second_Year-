<%- include('../partials/head') %>

<div class="page-heading">
  <div>
    <h2>My Family</h2>
    <p class="text-muted mb-0">
      Manage your family information and follow your children's progress.
    </p>
  </div>
</div>

<% if (saved) { %>
  <div class="alert alert-success">
    <i class="bi bi-check-circle"></i> Changes saved successfully.
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card p-4 h-100">
      <div class="text-muted mb-2">My Children</div>
      <h2 class="mb-0"><%= players.length %></h2>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card p-4 h-100">
      <div class="text-muted mb-2">Registrations</div>
      <h2 class="mb-0"><%= registrations.length %></h2>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card p-4 h-100">
      <div class="text-muted mb-2">Training Sessions</div>
      <h2 class="mb-0"><%= sessions.length %></h2>
    </div>
  </div>
</div>

<div class="card p-4 mb-4">
  <h4 class="mb-3">
    <i class="bi bi-person-circle"></i> My Profile
  </h4>

  <p class="mb-3">
    <strong><%= parent.first_name %> <%= parent.last_name %></strong>
  </p>

  <form method="post" action="/parent/profile">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label">Phone</label>
        <input
          class="form-control"
          type="tel"
          name="phone"
          value="<%= parent.phone || '' %>"
          required
        >
      </div>

      <div class="col-md-5">
        <label class="form-label">Email</label>
        <input
          class="form-control"
          type="email"
          name="email"
          value="<%= parent.email || '' %>"
        >
      </div>

      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-save"></i> Save
        </button>
      </div>
    </div>
  </form>
</div>

<div class="card p-4 mb-4">
  <h4 class="mb-3">
    <i class="bi bi-people"></i> My Children
  </h4>

  <% if (players.length === 0) { %>
    <p class="text-muted mb-0">No children linked to your account.</p>
  <% } %>

  <% players.forEach(p => { %>
    <div class="border rounded-3 p-3 mb-3">
      <h5 class="mb-1">
        <%= p.first_name %> <%= p.last_name %>
      </h5>

      <p class="text-muted small mb-3">
        Date of Birth: <%= p.date_of_birth %>
      </p>

      <form method="post" action="/parent/child/<%= p.player_id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3 align-items-end">
          <div class="col-md-5">
            <label class="form-label">First Name</label>
            <input
              class="form-control"
              name="first_name"
              value="<%= p.first_name %>"
              required
            >
          </div>

          <div class="col-md-5">
            <label class="form-label">Last Name</label>
            <input
              class="form-control"
              name="last_name"
              value="<%= p.last_name %>"
              required
            >
          </div>

          <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">
              Update
            </button>
          </div>
        </div>
      </form>
    </div>
  <% }) %>
</div>

<div class="card p-4 mb-4">
  <h4 class="mb-3">
    <i class="bi bi-journal-check"></i> Registrations
  </h4>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Player</th>
          <th>Class</th>
          <th>Status</th>
        </tr>
      </thead>

      <tbody>
        <% registrations.forEach(r => { %>
          <tr>
            <td><%= r.first_name %> <%= r.last_name %></td>
            <td><%= r.class_name %></td>
            <td>
              <% if (r.status === 'Active') { %>
                <span class="badge bg-success">Active</span>
              <% } else if (r.status === 'Pending') { %>
                <span class="badge bg-warning text-dark">Pending</span>
              <% } else { %>
                <span class="badge bg-secondary"><%= r.status %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>

        <% if (registrations.length === 0) { %>
          <tr>
            <td colspan="3" class="text-center text-muted py-4">
              No registrations found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card p-4 mb-4">
  <h4 class="mb-3">
    <i class="bi bi-calendar-event"></i> Training Schedule
  </h4>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Player</th>
          <th>Class</th>
          <th>Date</th>
          <th>Time</th>
        </tr>
      </thead>

      <tbody>
        <% sessions.forEach(s => { %>
          <tr>
            <td><%= s.first_name %></td>
            <td><%= s.class_name %></td>
            <td><%= s.session_date %></td>
            <td><%= s.start_time %></td>
          </tr>
        <% }) %>

        <% if (sessions.length === 0) { %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">
              No training sessions scheduled.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card p-4">
  <h4 class="mb-3">
    <i class="bi bi-check2-square"></i> Attendance History
  </h4>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Player</th>
          <th>Class</th>
          <th>Date</th>
          <th>Status</th>
        </tr>
      </thead>

      <tbody>
        <% attendance.forEach(a => { %>
          <tr>
            <td><%= a.first_name %> <%= a.last_name %></td>
            <td><%= a.class_name %></td>
            <td><%= a.session_date %></td>
            <td>
              <% if (a.status === 'Present') { %>
                <span class="badge bg-success">Present</span>
              <% } else if (a.status === 'Late') { %>
                <span class="badge bg-warning text-dark">Late</span>
              <% } else if (a.status === 'Absent') { %>
                <span class="badge bg-danger">Absent</span>
              <% } else { %>
                <span class="badge bg-secondary"><%= a.status %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>

        <% if (attendance.length === 0) { %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">
              No attendance records found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>